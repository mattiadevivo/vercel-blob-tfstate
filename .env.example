BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx
AUTH_PASSWORD=your-secret-password
# Lock backend: 'redis' (default, distributed) or 'memory' (in-process, no Redis
# required - suitable for single-instance deployments such as CI).
LOCK_BACKEND=redis
REDIS_URL=redis://localhost:6379
REDIS_LOCK_ACQUIRE_ATTEMPTS=3
HTTP_PORT=8090
