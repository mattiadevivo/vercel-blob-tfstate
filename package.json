{
    "name": "vercel-blob-tfstate",
    "author": {
        "name": "Mattia De Vivo",
        "email": "mattiadevivo@gmail.com",
        "url": "https://mattiadevivo.dev"
    },
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc",
        "start": "node dist/index.js",
        "format": "oxfmt --write src tests *.json *.yml *.yaml",
        "format:check": "oxfmt --check src tests *.json *.yml *.yaml",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "prepare": "[ -d .git ] && husky || true",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@hono/node-server": "^2.0.4",
        "@hono/standard-validator": "^0.4.0",
        "@hono/swagger-ui": "^0.6.1",
        "@hono/zod-validator": "^0.8.0",
        "@vercel/blob": "^2.3.3",
        "dotenv": "^17.4.2",
        "hono": "^4.12.14",
        "hono-openapi": "^1.3.1",
        "ioredis": "^5.10.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "husky": "^9.1.7",
        "oxfmt": "^0.52.0",
        "oxlint": "^1.61.0",
        "tsx": "^4.7.1",
        "typescript": "^5.8.3",
        "vitest": "^4.1.7"
    },
    "packageManager": "pnpm@10.33.2"
}
